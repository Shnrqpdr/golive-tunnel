#!/bin/bash
# WireGuard access to the golive-tunnel server. Each friend is a [Peer] block in wg0.conf, with
# their name and who added them in comments, so list and remove can find them.
#
# usage (owner, as root):
#      golive-peer add <name> <public-key>
#      golive-peer remove <name>
#      golive-peer list
#      golive-peer delegate-add <name> <ssh-ed25519-key> <limit>
#      golive-peer delegate-remove <name>
#      golive-peer delegates
#
# A delegate is a friend who lets others in on their own. They get here through
# golive-delegate-login, as "golive-peer as <name> add|remove|list ...": they see everyone, add up
# to their limit and only remove whoever they added themselves.
#
# Messages are in Portuguese: the owner and the delegates read them.
set -euo pipefail
CONF=/etc/wireguard/wg0.conf
IFACE=wg0
DELEGATES=/etc/wireguard/delegates
DELEGATE_USER=golive-delegate
DELEGATE_KEYS=/home/$DELEGATE_USER/.ssh/authorized_keys
DELEGATE_LOGIN=/usr/local/sbin/golive-delegate-login
SUDOERS=/etc/sudoers.d/golive-delegate

# Names and keys come from someone else's message and become root's configuration lines.
check_name() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo "nome invalido: use letras sem acento, numeros, - e _, ate 32" >&2; exit 2; }; }
check_key() { [[ "$1" =~ ^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$ ]] || { echo "chave invalida: nao e uma chave publica WireGuard" >&2; exit 2; }; }

# The executable does the same math: the address comes from the key itself, so nobody has to
# agree on an IP. It stays in 10.66.1-254.1-254, away from the server's 10.66.0.1.
address_for() {
    local h
    h=$(printf '%s' "$1" | base64 -d | sha256sum | cut -c1-4)
    echo "10.66.$(( 0x${h:0:2} % 254 + 1 )).$(( 0x${h:2:2} % 254 + 1 ))"
}

# Prints "name key address added-by" for each friend in wg0.conf. No added-by means the owner.
peers() {
    awk '/^\[Peer\]/ { n=""; k=""; by="owner" }
         /^# name: / { n=$3 }
         /^# added-by: / { by=$3 }
         /^PublicKey = / { k=$3 }
         /^AllowedIPs = / { a=$3; sub("/32", "", a); if (n != "") print n, k, a, by }' "$CONF"
}

# "owner" is stored in wg0.conf; people read "dono".
who() { if [ "$1" = owner ]; then echo dono; else echo "$1"; fi; }

ACTOR=owner
if [ "${1:-}" = as ]; then
    [ $# -ge 3 ] || { echo "uso: golive-peer as <liberador> add|remove|list ..." >&2; exit 2; }
    ACTOR=$2; shift 2
    check_name "$ACTOR"
    [ "$ACTOR" != owner ] || { echo "owner nao e liberador" >&2; exit 3; }
    LIMIT=$(awk -v n="$ACTOR" '$1 == n { print $2 }' "$DELEGATES" 2>/dev/null)
    [ -n "$LIMIT" ] || { echo "$ACTOR nao e liberador" >&2; exit 3; }
    case "$1" in add|remove|list) ;; *) echo "liberador so pode usar add, remove e list" >&2; exit 3 ;; esac
fi

case "${1:-}" in
add)
    [ $# -eq 3 ] || { echo "uso: add <nome> <chave-publica>" >&2; exit 2; }
    name=$2; key=$3
    check_name "$name"; check_key "$key"
    if peers | awk -v k="$key" '$2 == k { f=1 } END { exit !f }'; then echo "essa chave ja esta liberada"; exit 0; fi
    if peers | awk -v n="$name" '$1 == n { f=1 } END { exit !f }'; then echo "ja existe alguem chamado $name, escolha outro nome" >&2; exit 1; fi
    if [ "$ACTOR" != owner ]; then
        used=$(peers | awk -v a="$ACTOR" '$4 == a' | wc -l)
        [ "$used" -lt "$LIMIT" ] || { echo "limite de $LIMIT pessoas atingido: peca ao dono do servidor para aumentar" >&2; exit 1; }
    fi
    ip=$(address_for "$key")
    if peers | awk -v i="$ip" '$3 == i { f=1 } END { exit !f }'; then echo "o endereco $ip dessa chave ja e de outra pessoa: peca para gerar outra chave" >&2; exit 1; fi
    printf '\n[Peer]\n# name: %s\n# added-by: %s\nPublicKey = %s\nAllowedIPs = %s/32\n' "$name" "$ACTOR" "$key" "$ip" >> "$CONF"
    wg set "$IFACE" peer "$key" allowed-ips "$ip/32"
    logger -t golive-peer -- "$ACTOR liberou $name ($ip)"
    echo "liberado: $name ($ip)"
    ;;
remove)
    [ $# -eq 2 ] || { echo "uso: remove <nome>" >&2; exit 2; }
    name=$2; check_name "$name"
    read -r key by < <(peers | awk -v n="$name" '$1 == n { print $2, $4 }') || true
    [ -n "${key:-}" ] || { echo "nenhum acesso com o nome $name" >&2; exit 1; }
    if [ "$ACTOR" != owner ] && [ "$by" != "$ACTOR" ]; then
        echo "$name foi liberado por $(who "$by"): so quem liberou ou o dono do servidor pode cortar" >&2; exit 1
    fi
    tmp=$(mktemp /etc/wireguard/.wg0.XXXXXX)
    # Cut the name's whole [Peer] block, and the trailing blank lines left at the end of the file.
    awk -v n="$name" '
        /^\[Peer\]/ { if (block != "" && !cut) printf "%s", block; block=""; cut=0; inside=1 }
        inside { block = block $0 "\n"; if ($0 == "# name: " n) cut=1; next }
        { print }
        END { if (block != "" && !cut) printf "%s", block }' "$CONF" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$tmp"
    chmod 600 "$tmp"; mv "$tmp" "$CONF"
    wg set "$IFACE" peer "$key" remove
    logger -t golive-peer -- "$ACTOR cortou $name"
    echo "cortado: $name"
    ;;
list)
    declare -A seen
    while read -r k t; do seen[$k]=$t; done < <(wg show "$IFACE" latest-handshakes)
    peers | while read -r n k i by; do
        t=${seen[$k]:-0}
        if [ "$t" = 0 ]; then when="nunca conectou"; else when="ultimo contato $(date -d "@$t" '+%d/%m %H:%M')"; fi
        printf '%-20s %-15s %-12s %s\n' "$n" "$i" "por $(who "$by")" "$when"
    done
    ;;
delegate-add)
    [ $# -eq 4 ] || { echo "uso: golive-peer delegate-add <nome> <chave-ssh-ed25519> <limite>" >&2; exit 2; }
    name=$2; key=$3; limit=$4
    check_name "$name"
    # "owner" marks the owner's own peers in wg0.conf: a delegate with that name would act as the owner.
    [ "$name" != owner ] || { echo "o nome owner e reservado, escolha outro" >&2; exit 2; }
    [[ "$key" =~ ^AAAAC3NzaC1lZDI1NTE5[A-Za-z0-9+/]{48}$ ]] || { echo "chave invalida: nao e uma chave publica SSH ed25519" >&2; exit 2; }
    [[ "$limit" =~ ^[0-9]{1,4}$ ]] || { echo "limite invalido: use um numero" >&2; exit 2; }

    if ! id "$DELEGATE_USER" >/dev/null 2>&1; then
        # A real shell because sshd runs the forced command through it; there is no password, and
        # the key only runs golive-delegate-login.
        useradd -m -s /bin/sh "$DELEGATE_USER"
        passwd -l "$DELEGATE_USER" >/dev/null
    fi
    install -d -m 700 -o "$DELEGATE_USER" -g "$DELEGATE_USER" "$(dirname "$DELEGATE_KEYS")"
    touch "$DELEGATE_KEYS" "$DELEGATES"
    # One line per delegate: granting again replaces the key and the limit, without duplicates.
    sed -i "/ $name\$/d" "$DELEGATE_KEYS"
    sed -i "/^$name /d" "$DELEGATES"
    printf 'restrict,command="%s %s" ssh-ed25519 %s %s\n' "$DELEGATE_LOGIN" "$name" "$key" "$name" >> "$DELEGATE_KEYS"
    printf '%s %s\n' "$name" "$limit" >> "$DELEGATES"
    chown "$DELEGATE_USER:$DELEGATE_USER" "$DELEGATE_KEYS"; chmod 600 "$DELEGATE_KEYS" "$DELEGATES"

    rule=$(mktemp)
    echo "$DELEGATE_USER ALL=(root) NOPASSWD: /usr/local/sbin/golive-peer as *" > "$rule"
    visudo -cqf "$rule" || { rm -f "$rule"; echo "regra do sudo invalida" >&2; exit 1; }
    install -m 440 "$rule" "$SUDOERS"; rm -f "$rule"

    logger -t golive-peer -- "dono deu liberador a $name (limite $limit)"
    echo "liberador: $name pode liberar ate $limit pessoas"
    ;;
delegate-remove)
    [ $# -eq 2 ] || { echo "uso: golive-peer delegate-remove <nome>" >&2; exit 2; }
    name=$2; check_name "$name"
    grep -q "^$name " "$DELEGATES" 2>/dev/null || { echo "$name nao e liberador" >&2; exit 1; }
    sed -i "/ $name\$/d" "$DELEGATE_KEYS"
    sed -i "/^$name /d" "$DELEGATES"
    logger -t golive-peer -- "dono tirou o liberador de $name"
    echo "$name nao libera mais ninguem. Quem ele liberou continua com acesso:"
    peers | awk -v a="$name" '$4 == a { print "    " $1 }'
    ;;
delegates)
    [ -s "$DELEGATES" ] || { echo "nenhum liberador"; exit 0; }
    while read -r n l; do
        printf '%-20s liberou %s de %s\n' "$n" "$(peers | awk -v a="$n" '$4 == a' | wc -l)" "$l"
    done < "$DELEGATES"
    ;;
*)
    echo "uso: golive-peer add|remove|list|delegate-add|delegate-remove|delegates" >&2; exit 2
    ;;
esac
