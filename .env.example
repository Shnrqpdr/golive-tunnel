# Copy to .env and fill in; .env stays out of git. server/install.sh prints these three lines
# at the end of the setup.

# Public address and port of the server's WireGuard (host:port).
GOLIVE_SERVER=203.0.113.10:51820

# The server's WireGuard public key: the output of `wg show wg0 public-key` on the server.
GOLIVE_SERVER_KEY=put-the-server-public-key-here=

# The server's SSH host key, pinned in the delegates' script: the content of
# /etc/ssh/ssh_host_ed25519_key.pub on the server, without the comment at the end.
GOLIVE_SSH_HOST_KEY="ssh-ed25519 put-the-server-host-key-here"
