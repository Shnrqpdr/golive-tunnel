# Copie para .env e preencha. O .env fica fora do git.

# Endereco publico e porta do WireGuard do servidor (host:porta).
GOLIVE_SERVIDOR=203.0.113.10:51820

# Chave publica do servidor: a saida de `wg show wg0 public-key` no VPS.
GOLIVE_CHAVE_SERVIDOR=coloque-aqui-a-chave-publica-do-servidor=

# Identidade SSH do servidor, para o Liberar-pessoal.ps1 dos liberadores: o conteudo de
# /etc/ssh/ssh_host_ed25519_key.pub no VPS, sem o comentario do fim.
GOLIVE_SSH_IDENTIDADE="ssh-ed25519 coloque-aqui-a-chave-do-servidor"
