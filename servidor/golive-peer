#!/bin/bash
# Acessos WireGuard do tunel do DiscordGoLiveBypass. Cada amigo e um bloco [Peer] no
# wg0.conf, com o nome e quem liberou em comentarios, para o list e o remove acharem.
#
# uso (dono, como root):
#      golive-peer add <nome> <chave-publica>
#      golive-peer remove <nome>
#      golive-peer list
#      golive-peer liberador-add <nome> <chave-ssh-ed25519> <limite>
#      golive-peer liberador-remove <nome>
#      golive-peer liberadores
#
# Um liberador e um amigo que libera outros sozinho. Ele chega aqui pelo golive-liberador,
# como "golive-peer como <nome> add|remove|list ...": ve todo mundo, libera ate o limite dele
# e so corta quem ele mesmo liberou.
set -euo pipefail
CONF=/etc/wireguard/wg0.conf
IFACE=wg0
LIBERADORES=/etc/wireguard/liberadores
LIB_USUARIO=liberador
LIB_CHAVES=/home/liberador/.ssh/authorized_keys
SUDOERS=/etc/sudoers.d/golive-liberador

# O nome e a chave chegam de mensagem de terceiros e viram linha de configuracao do root.
valida_nome() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo "nome invalido: use letras sem acento, numeros, - e _, ate 32" >&2; exit 2; }; }
valida_chave() { [[ "$1" =~ ^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$ ]] || { echo "chave invalida: nao e uma chave publica WireGuard" >&2; exit 2; }; }

# O executavel faz a mesma conta: o endereco sai da propria chave, e ninguem precisa
# combinar IP. Fica em 10.66.1-254.1-254, longe do 10.66.0.1 do servidor.
ip_da_chave() {
    local h
    h=$(printf '%s' "$1" | base64 -d | sha256sum | cut -c1-4)
    echo "10.66.$(( 0x${h:0:2} % 254 + 1 )).$(( 0x${h:2:2} % 254 + 1 ))"
}

# Imprime "nome chave ip por" de cada amigo do wg0.conf. Quem nao tem "por" e do dono.
amigos() {
    awk '/^\[Peer\]/ { n=""; k=""; p="dono" }
         /^# nome: / { n=$3 }
         /^# por: / { p=$3 }
         /^PublicKey = / { k=$3 }
         /^AllowedIPs = / { a=$3; sub("/32", "", a); if (n != "") print n, k, a, p }' "$CONF"
}

ATOR=dono
if [ "${1:-}" = como ]; then
    [ $# -ge 3 ] || { echo "uso: golive-peer como <liberador> add|remove|list ..." >&2; exit 2; }
    ATOR=$2; shift 2
    valida_nome "$ATOR"
    LIMITE=$(awk -v n="$ATOR" '$1 == n { print $2 }' "$LIBERADORES" 2>/dev/null)
    [ -n "$LIMITE" ] || { echo "$ATOR nao e liberador" >&2; exit 3; }
    case "$1" in add|remove|list) ;; *) echo "liberador so pode usar add, remove e list" >&2; exit 3 ;; esac
fi

case "${1:-}" in
add)
    [ $# -eq 3 ] || { echo "uso: add <nome> <chave-publica>" >&2; exit 2; }
    nome=$2; chave=$3
    valida_nome "$nome"; valida_chave "$chave"
    if amigos | awk -v k="$chave" '$2 == k { f=1 } END { exit !f }'; then echo "essa chave ja esta liberada"; exit 0; fi
    if amigos | awk -v n="$nome" '$1 == n { f=1 } END { exit !f }'; then echo "ja existe alguem chamado $nome, escolha outro nome" >&2; exit 1; fi
    if [ "$ATOR" != dono ]; then
        usados=$(amigos | awk -v a="$ATOR" '$4 == a' | wc -l)
        [ "$usados" -lt "$LIMITE" ] || { echo "limite de $LIMITE pessoas atingido: peca ao dono do servidor para aumentar" >&2; exit 1; }
    fi
    ip=$(ip_da_chave "$chave")
    if amigos | awk -v i="$ip" '$3 == i { f=1 } END { exit !f }'; then echo "o endereco $ip dessa chave ja e de outra pessoa: peca para gerar outra chave" >&2; exit 1; fi
    printf '\n[Peer]\n# nome: %s\n# por: %s\nPublicKey = %s\nAllowedIPs = %s/32\n' "$nome" "$ATOR" "$chave" "$ip" >> "$CONF"
    wg set "$IFACE" peer "$chave" allowed-ips "$ip/32"
    logger -t golive-peer -- "$ATOR liberou $nome ($ip)"
    echo "liberado: $nome ($ip)"
    ;;
remove)
    [ $# -eq 2 ] || { echo "uso: remove <nome>" >&2; exit 2; }
    nome=$2; valida_nome "$nome"
    read -r chave por < <(amigos | awk -v n="$nome" '$1 == n { print $2, $4 }') || true
    [ -n "${chave:-}" ] || { echo "nenhum acesso com o nome $nome" >&2; exit 1; }
    if [ "$ATOR" != dono ] && [ "$por" != "$ATOR" ]; then
        echo "$nome foi liberado por $por: so quem liberou ou o dono do servidor pode cortar" >&2; exit 1
    fi
    tmp=$(mktemp /etc/wireguard/.wg0.XXXXXX)
    # Corta o bloco [Peer] inteiro do nome, junto com a linha em branco que o abria.
    awk -v n="$nome" '
        /^\[Peer\]/ { if (bloco != "" && !corta) printf "%s", bloco; bloco=""; corta=0; dentro=1 }
        dentro { bloco = bloco $0 "\n"; if ($0 == "# nome: " n) corta=1; next }
        { print }
        END { if (bloco != "" && !corta) printf "%s", bloco }' "$CONF" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$tmp"
    chmod 600 "$tmp"; mv "$tmp" "$CONF"
    wg set "$IFACE" peer "$chave" remove
    logger -t golive-peer -- "$ATOR cortou $nome"
    echo "cortado: $nome"
    ;;
list)
    declare -A visto
    while read -r k t; do visto[$k]=$t; done < <(wg show "$IFACE" latest-handshakes)
    amigos | while read -r n k i p; do
        t=${visto[$k]:-0}
        if [ "$t" = 0 ]; then quando="nunca conectou"; else quando="ultimo contato $(date -d "@$t" '+%d/%m %H:%M')"; fi
        printf '%-20s %-15s %-12s %s\n' "$n" "$i" "por $p" "$quando"
    done
    ;;
liberador-add)
    [ $# -eq 4 ] || { echo "uso: golive-peer liberador-add <nome> <chave-ssh-ed25519> <limite>" >&2; exit 2; }
    nome=$2; chave=$3; limite=$4
    valida_nome "$nome"
    [[ "$chave" =~ ^AAAAC3NzaC1lZDI1NTE5[A-Za-z0-9+/]{48}$ ]] || { echo "chave invalida: nao e uma chave publica SSH ed25519" >&2; exit 2; }
    [[ "$limite" =~ ^[0-9]{1,4}$ ]] || { echo "limite invalido: use um numero" >&2; exit 2; }

    if ! id "$LIB_USUARIO" >/dev/null 2>&1; then
        # Shell de verdade porque o sshd roda o comando forcado por ele; sem senha, e a chave
        # so executa o golive-liberador.
        useradd -m -s /bin/sh "$LIB_USUARIO"
        passwd -l "$LIB_USUARIO" >/dev/null
    fi
    install -d -m 700 -o "$LIB_USUARIO" -g "$LIB_USUARIO" "$(dirname "$LIB_CHAVES")"
    touch "$LIB_CHAVES" "$LIBERADORES"
    # Uma linha por liberador: dar de novo troca a chave e o limite, sem duplicar.
    sed -i "/ $nome\$/d" "$LIB_CHAVES"
    sed -i "/^$nome /d" "$LIBERADORES"
    printf 'restrict,command="/usr/local/sbin/golive-liberador %s" ssh-ed25519 %s %s\n' "$nome" "$chave" "$nome" >> "$LIB_CHAVES"
    printf '%s %s\n' "$nome" "$limite" >> "$LIBERADORES"
    chown "$LIB_USUARIO:$LIB_USUARIO" "$LIB_CHAVES"; chmod 600 "$LIB_CHAVES" "$LIBERADORES"

    regra=$(mktemp)
    echo "$LIB_USUARIO ALL=(root) NOPASSWD: /usr/local/sbin/golive-peer como *" > "$regra"
    visudo -cqf "$regra" || { rm -f "$regra"; echo "regra do sudo invalida" >&2; exit 1; }
    install -m 440 "$regra" "$SUDOERS"; rm -f "$regra"

    logger -t golive-peer -- "dono deu liberador a $nome (limite $limite)"
    echo "liberador: $nome pode liberar ate $limite pessoas"
    ;;
liberador-remove)
    [ $# -eq 2 ] || { echo "uso: golive-peer liberador-remove <nome>" >&2; exit 2; }
    nome=$2; valida_nome "$nome"
    grep -q "^$nome " "$LIBERADORES" 2>/dev/null || { echo "$nome nao e liberador" >&2; exit 1; }
    sed -i "/ $nome\$/d" "$LIB_CHAVES"
    sed -i "/^$nome /d" "$LIBERADORES"
    logger -t golive-peer -- "dono tirou o liberador de $nome"
    echo "$nome nao libera mais ninguem. Quem ele liberou continua com acesso:"
    amigos | awk -v a="$nome" '$4 == a { print "    " $1 }'
    ;;
liberadores)
    [ -s "$LIBERADORES" ] || { echo "nenhum liberador"; exit 0; }
    while read -r n l; do
        printf '%-20s liberou %s de %s\n' "$n" "$(amigos | awk -v a="$n" '$4 == a' | wc -l)" "$l"
    done < "$LIBERADORES"
    ;;
*)
    echo "uso: golive-peer add|remove|list|liberador-add|liberador-remove|liberadores" >&2; exit 2
    ;;
esac
