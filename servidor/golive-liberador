#!/bin/bash
# Comando forcado da chave de cada liberador, no authorized_keys do usuario liberador. O nome
# chega como argumento, gravado pelo dono na linha da chave: quem conecta nao escolhe quem e.
# O que ele pediu vem em SSH_ORIGINAL_COMMAND e so passa se for add, remove ou list.
set -euo pipefail
ator=${1:?}
pedido=${SSH_ORIGINAL_COMMAND:-}

# So palavras simples: nada de aspas, ponto e virgula, redirecionamento, curinga ou expansao.
[[ "$pedido" =~ ^[A-Za-z0-9_+/=\ -]{1,200}$ ]] || { echo "pedido recusado" >&2; exit 2; }
read -r -a args <<< "$pedido"

logger -t golive-liberador -- "$ator pediu: $pedido"
exec sudo -n /usr/local/sbin/golive-peer como "$ator" "${args[@]}"
